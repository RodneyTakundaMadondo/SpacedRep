@model HomeViewModel;

@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}




@if (!Model.StudyTopics.Any())
{
   <div class="container d-flex flex-column gap-3 empty-state-container py-3 px-2">
       <div class="empty-logo-container">
           <img src="~/Images/spacedRepDark.svg" alt="SpacedRep Logo"/>
       </div>
       <h1 class="text-center fw-bold">Welcome to SpacedRep!</h1>
        <p class="text-center">
            Start your learning journey by creating your first study topic. We'll help you remember everything through scientifically proven spaced repetition.
        </p>
        <a class="add-topic-btn fw-bold d-block text-center rounded-pill  px-3 py-2   mx-auto" asp-action="Add" asp-controller="StudyTopic">+ Create Your First Topic</a>

        <div class="d-flex justify-content-between flex-wrap app-benefits gap-3">
            <div class="d-flex flex-column gap-2">
                <div class="bg-danger empty-icon-container"><i class="fa-solid fa-book-open"></i></div>
                <h6 class="text-center fw-bold">Smart Scheduling</h6>
                <p class="text-center">Automatically schedules reviews at optimal intervals to maximize retention</p>
            </div>

            <div class="d-flex flex-column gap-2">
                <div class="bg-danger empty-icon-container"><i class="fa-solid fa-circle-check text-white"></i></div>
                <h6 class="text-center fw-bold">Track Progress</h6>
                <p class="text-center">
                    Monitor your learning journey and see your knowledge retention improve
                </p>
            </div>
            <div class="d-flex flex-column gap-2">
                <div class="bg-danger empty-icon-container"><i class="fa-solid fa-envelope"></i></div>
                <h6 class="text-center fw-bold">Daily Reminders</h6>
                <p class="text-center">
                    Get notified when it's time to review so you never miss a session
                </p>
            </div>
        </div>
   </div>
}
else
{
    <a class="sec-add-topic-btn fw-bold d-block text-center rounded-pill  px-3 py-2   mx-auto my-4" asp-action="Add" asp-controller="StudyTopic">+ Add a Study Topic</a>
        <div class="row g-3">

            @foreach (var topic in Model.StudyTopics)
            {
            // px-3 py-4 mb-4 topic-card
            <div class=" col-12  col-md-6  col-lg-4  ">
                @{
                    var i = 1;
                }
                <div data-url="@Url.Action("Details","StudyTopic",new{id=topic.StudyTopicId})" class="topic-card text-decoration-none px-3 py-4 d-flex flex-column justify-content-between h-100">
                    <div class="">
                        <h1 class="topic-title fw-bold fs-5 ">@topic.Title</h1>
                        @* <input type="hidden" asp-for="@topic.Description" id="hiddenContent-@topic.StudyTopicId"/> *@
                        <p class="topic-description">@DocumentHelper.QuillToPlainText(topic.Description)</p> 
                        <div class="d-flex gap-2 align-items-center task-start-container mb-4">
                            <i class="fa-solid fa-calendar"></i>
                            <span class="text-secondary">Started:@topic?.DateStarted.Value.ToString("yyyy/MM/dd")</span> 
                                @* remember to make dateStarted not nullable *@
                        </div>
                        <div class="mb-3 document-container">
                            <h3 class="text-uppercase">Documents</h3>
                            <div class="d-flex flex-column gap-2">
                                @if (topic.Files?.Any() == true)
                                {
                                    foreach (var file in topic.Files)
                                    {
                                        <div  class="d-flex align-items-center justify-content-between  pdf-item ">
                                           <div class="d-flex flex-wrap gap-2">
                                                <div class="pdf-icon-container rounded-2"><i class="fa-regular fa-file"></i></div>
                                                <a href="@file.FilePath" target="_blank" class="file-info text-decoration-none">
                                                    <span class="d-block file-name text-black fw-bold ">@file.FileName</span>
                                                    <span class="text-black">@file.FileSize MB</span>
                                                </a>
                                           </div>
                                            <button data-id="@file.Id"
                                                    data-name="@file.FileName"
                                                    data-url="@Url.Action("DeleteDoc", "StudyFile")"
                                                    onclick="openDeleteModal(this)"
                                                type="button" class="doc-delete-btn ">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p>No documents uploaded yet</p>
                                }
                            </div>


                        </div>

                        <div>
                            <h3 class="text-uppercase fw-bold fs-6">Revision Schedule</h3>
                            <ul class="revision-schedule-list">
                                @foreach (var revday in topic.Revisions)
                                {
                        <li class="d-flex revision-item justify-content-between  @(revday.ScheduledDate.Date <= DateTime.Today.Date ? "completed-revision text-success" : "")">
                            
                                        <div class="d-flex align-items-center gap-2">
                                @Html.Raw(revday.ScheduledDate.Date <= DateTime.Today
                                                                ? "<i class='fa-solid fa-circle-check'></i>"
                                                                : "")
                                <span>Day @revday.RevisionNumber</span>
                                            </div>
                                        <span class="revision-date">@revday.ScheduledDate.ToString("yyyy/MM/dd")</span>
                                    </li>
                                    i++;
                                }

                            </ul>
                        </div>

                    </div>

                    <div class="d-flex justify-content-between">
                        @if(topic.Files is not null && topic.Files.Count>=1)
                        {
                             @foreach(var file in topic.Files)
                            {
                               
                                <button class="btn-quiz px-2 text-center rounded-3"
                                    data-fileId="@file.Id"
                                    data-topicId ="@topic.StudyTopicId"
                                    onclick="openQuizModal(this)"
                                ><i class="fa-solid fa-circle-question me-2"></i>Quiz Me</button>
                            }
                        }
                        else
                        {
                            <a asp-action="TopicQuiz" asp-controller="studytopic" asp-route-topicId="@topic.StudyTopicId" class=" text-center rounded-3  text-decoration-none btn-quiz px-2"><i class="fa-solid fa-circle-question me-2"></i>Quiz Me</a>
                        }

                        
                        <a class="edit-btn text-dark text-center rounded-3" asp-action="Edit" asp-route-id="@topic.StudyTopicId" asp-controller="StudyTopic">Edit</a>

                        <button class="delete-btn text-center rounded-3"
                                data-id="@topic.StudyTopicId"
                                data-name="@topic.Title"
                                data-url="@Url.Action("Delete","StudyTopic")"
                                onclick="openDeleteModal(this)"
                                >
                            Delete
                        </button>

                    </div>
               </div>
            </div>
            }


        </div>

   
}
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirm delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>
                    Are you sure you want to delete
                    <strong id="deleteItemName"></strong>?
                </p>
            </div>

            <div class="modal-footer">
                <form method="post" id="deleteForm" >
                    
                    <input type="hidden" name="id" id="deleteItemId" />

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@* quiz modal *@
<div class="modal fade" id="quizModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-3">

            <div class="modal-header">
                <h5 class="modal-title fw-bold">Confirm Quiz Source</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="modal-description">
                    Choose what we make the quiz with:
                </p>
            </div>

            <div class="d-flex flex-column gap-2 my-2">
               
                <a class="topic-desc-quiz-link option-card text-decoration-none text-black">
                        <div class="d-flex flex-wrap gap-2">
                        <div class="modal-icon md-topic"><i class="fa-solid fa-circle-info"></i></div>
                        <span class="fw-bold">Topic Description based quiz</span>
                        <span class="recommended rounded-pill">Recommended</span>
                        </div>
                    <p class="my-2 modal-description">Generate questions based on your topic description and title. Quick and easy!</p>
                    </a>
               

                <a class="file-quiz-link option-card text-decoration-none text-black">
                    <div class="d-flex flex-wrap gap-2">
                        <div class="modal-icon md-file"><i class="fa-regular fa-file"></i></div>
                        <span class="fw-bold">File based quiz</span>
                    </div>
                    <p class="my-2 modal-description">
                        Use your uploaded documents to create detailed, accurate questions from your study materials.
                    </p>
                </a>
              
            </div>

        </div>
    </div>
</div>
<script>
    
    
    function openDeleteModal(button) {
        const id = button.getAttribute("data-id");
        const name = button.getAttribute("data-name");
        const url = button.getAttribute("data-url");

        document.getElementById("deleteItemId").value = id;
        document.getElementById("deleteItemName").textContent = name;
        document.getElementById("deleteForm").action = url;

        const modal = new bootstrap.Modal(document.getElementById("deleteModal"));
        modal.show();
    }

    function openQuizModal(button){
        const topicId = button.getAttribute("data-topicId");
        const fileId = button.getAttribute("data-fileId");

        let descLink = document.querySelector(".topic-desc-quiz-link");
        let fileLink = document.querySelector(".file-quiz-link");
        console.log(topicId);
        descLink.setAttribute("href", `/StudyTopic/TopicQuiz?topicId=${topicId}`);
        fileLink.setAttribute("href", `/StudyTopic/TopicQuiz?fileId=${fileId}`);

        const modal = new bootstrap.Modal(document.getElementById("quizModal"));
        modal.show();
    }

   
   
</script>


@section Scripts{
    <script>
        $(function(){
            $(".topic-card").on("click", function (e) {
                if (e.target.closest('button, a, input, form')) return;
                const url = $(this).data("url");
                if (url) {
                    window.location.href = url;
                }
            });

            
        })
    </script>
}







