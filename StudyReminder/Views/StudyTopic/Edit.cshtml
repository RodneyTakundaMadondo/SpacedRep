@model StudyTopic
@section Styles{
	<link rel="stylesheet" href="~/css/add.css" />
}
@{
	// ViewData["Title"] = "Edit Study Topic";
}

<div class=" add-container-wrapper pt-5">

	<div class="container add-container  px-3 py-4">
		<h1 class="text-center fw-bold fs-3 mb-4"> Update Study Topic</h1>

		<form class="edit-form"  asp-action="Edit" asp-controller="StudyTopic" method="post" enctype="multipart/form-data">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="@Model.StudyTopicId"/>
			<input type="hidden" asp-for="@Model.OwnerId"/>

			<div class="d-flex flex-column gap-2">
				<div class="mb-3 d-flex flex-column">
					<label asp-for="@Model.Title"></label>
					<input class="topic-title" type="text" asp-for="@Model.Title" placeholder="Enter topic title" />
					<span class="text-danger" asp-validation-for="@Model.Title"></span>
				</div>

				<div class="mb-3 d-flex flex-column">
					<label asp-for="@Model.Description"></label>
					<div id="editor"></div>
					<input type="hidden" asp-for="@Model.Description" id="hiddenContent" />
					<span class="text-danger" asp-validation-for="@Model.Description"></span>
				</div>

				<div class="mb-3 d-flex flex-column gap-2 flex-wrap">
					<div class="d-flex flex-column gap-2">
						<label asp-for="@Model.DateStarted"></label>
						<input class="topic-startdate" asp-for="@Model.DateStarted" value="@(Model.DateStarted.Value.ToString("yyyy-MM-dd"))" />
						<span class="text-danger" asp-validation-for="@Model.DateStarted"></span>
					</div>
					<div class="d-flex flex-column gap-2">
						<label asp-for="@Model.DueDate"></label>
						<input class="topic-enddate" asp-for="@Model.DueDate" value="@(Model.DueDate.HasValue? Model.DueDate.Value.ToString("yyyy-MM-dd"):"")" />
						<span class="text-danger" asp-validation-for="@Model.DueDate"></span>
					</div>
				</div>

				<div class="mb-3 d-flex flex-column">
					<label for="">Notes:</label>
					<input type="file" name="Files" multiple accept=".txt,.pdf,.docx" />
					<span asp-validation-for="Files" class="text-danger"></span>
				</div>

				<div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-3">
					<a class="cancel-btn text-center py-2 d-flex align-items-center justify-content-center" asp-action="Index" asp-controller="Home">Cancel</a>
					<button class="submit-btn text-white fw-bold">Update Topic</button>
				</div>
			</div>
		</form>



	</div>



</div>
<script>
	document.addEventListener("DOMContentLoaded",()=>{
		const quill = new Quill("#editor", {
			theme: "snow"
		});
		const existingContent = document.querySelector("#hiddenContent").value;
		
		if (existingContent) {
			let delta = JSON.parse(existingContent);
			
			if(typeof delta ==="string"){
				delta = JSON.parse(delta);
			}
			quill.setContents(delta);
			document.querySelector("#hiddenContent").value = "";
		}

		document.querySelector(".edit-form").addEventListener("submit", () => {
			var text = quill.getText().trim();
			console.log("text: " + text.length)
			if (text.length === 0) {
				return;
			} else {
				document.querySelector("#hiddenContent").value = JSON.stringify(quill.getContents());
			}
				
			})

	})

</script>

