<div class="container">
    <div class="registration-container">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <input asp-for="Input.Email" type="hidden" />
            <div class="mb-4 d-flex flex-column gap-3">
                <div class="center-icon"><i class="fa-solid fa-lock"></i></div>
                <h1 class="text-capitalize fw-bold text-center">Reset your password</h1>
                <p class="text-center">Enter your email and create a new password to regain access to your account.</p>
            </div>

           

            <div class=" mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <div class="input-icon-container">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Create a new password" />
                    <i class="input-icon fa-solid fa-lock"></i>
               </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class=" mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <div class="input-icon-container">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm your new password" />
                    <i class="input-icon fa-solid fa-shield"></i>
               </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="password-help rounded-3 p-3 my-3">
             
                <p>
                    💡 Choose a strong password that you haven't used elsewhere. We recommend using a mix of letters, numbers, and symbols.
                </p>
            </div>

         <div class="d-flex flex-column align-items-center gap-3">
                <button type="submit" class="btn-reset">Reset</button>
                <span class="custom-hr fs-3">OR</span>
                <a class="text-decoration-none home-link" asp-area="Identity" asp-page="/Account/Login"><i class="fa-solid fa-arrow-left me-2"></i>Back to Login</a>
         </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
