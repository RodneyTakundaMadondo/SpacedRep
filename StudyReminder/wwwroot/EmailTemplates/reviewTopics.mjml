<mjml>
  <mj-body>
    <mj-section> </mj-section>
    <mj-section border-radius="10px 10px 0px 0px" background-color="#764ba2">
      <mj-column>
        <mj-text
          align="center"
          font-weight="bold"
          font-size="32px"
          color="white"
        >
         Time to Review!⏰
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text font-weight="700" font-size="25px">
          Your Revision Reminder
        </mj-text>

        <mj-text> Hi there!👋 </mj-text>

        <mj-text>
          You have {{topic_count}} topic(s) scheduled for review today. Let's keep<br><br> that knowledge fresh!
        </mj-text>
      </mj-column>
    </mj-section>

 <mj-section
     
    >
      <mj-column>
      <mj-text>
      {{topicsBlock}}
      </mj-text>
      </mj-column>
    </mj-section>


   
 <mj-section>
      <mj-column><mj-spacer height="5px" /></mj-column>
    </mj-section>
    

    <mj-section
      border-left="5px solid #48bb78"
      border-radius="10px"
      background-color="#c6f6d5"
    >
      <mj-column>
        <mj-text>
        <strong>💡 Why spaced repetition works: </strong><br> 
        <br>
       Reviewing at the right intervals helps move information from short-term to long-<br>term memory. Just 10 minutes today will save you hours of cramming later!  
        </mj-text>
      </mj-column>
    </mj-section>

   

    <mj-section>
      <mj-column><mj-spacer height="5px" /></mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column padding="0"
        ><mj-divider padding="0" border-color="#cccccc" border-width="1px"
      /></mj-column>
    </mj-section>

    <mj-section background-color="#f7fafc">
      <mj-column>
        <mj-text align="center">Keep Learning!<br><br>The SpacedRep Team 
        <br> <br>
        SpacedRep - Learn. Review. Master
        </mj-text>
       

     
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
