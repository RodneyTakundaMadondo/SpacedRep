<mjml>
  <mj-body>
    <mj-section> </mj-section>
    <mj-section border-radius="10px 10px 0px 0px" background-color="#764ba2">
      <mj-column>
        <mj-text
          align="center"
          font-weight="bold"
          font-size="32px"
          color="white"
        >
          Password Reset Request 
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text font-weight="700" font-size="25px">
          Reset your Password
        </mj-text>

        <mj-text> Hi there!👋 </mj-text>

        <mj-text>
          We have received a request to reset the password for your SpacedRep account.
        </mj-text>

        <mj-text>
         Click the button below to create a new password:
        </mj-text>
        <mj-button
          border-radius="5px"
          background-color="#764ba2"
          font-weight="600"
          font-size="16px"
          href="{{resetLink}}"
          >Reset Password</mj-button
        >

       
      </mj-column>
    </mj-section>

   

 

    <mj-section
      border-left="5px solid #fc8181"
      border-radius="10px"
      background-color="#fff5f5"
    >
      <mj-column>
        <mj-text>
        <strong>🔒 Security Notice </strong><br> 
        <br>
        This link will expire in 1 hour for security reasons. If you didn't request a password reset, please ignore this email. Your password will remain unchanged. 
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
    <mj-column>
    <mj-text color="#b4b4b4">
    If you're having trouble, contact our support team for assistance.
    </mj-text>
    </mj-column>
    </mj-section>

    <mj-section>
      <mj-column><mj-spacer height="5px" /></mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column padding="0"
        ><mj-divider padding="0" border-color="#cccccc" border-width="1px"
      /></mj-column>
    </mj-section>

    <mj-section background-color="#f7fafc">
      <mj-column>
        <mj-text align="center"> Stay Secure!<br><br>The SpacedRep Team 
        <br> <br>
        SpacedRep - Learn. Review. Master
        </mj-text>
       

     
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
